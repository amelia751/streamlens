# Environment for the analyst agent on Agent Runtime (dotenv format).
# Passed with: adk deploy agent_engine --env_file deploy/agent-runtime.vars
#
# No secrets here. The Cloud Run MCP service is reached with an IAM ID
# token, and it loads the ClickHouse credentials from Secret Manager itself.
GOOGLE_CLOUD_PROJECT=pctg-503822

# Selects the streamable-HTTP transport instead of a uvx subprocess.
STREAMLENS_MCP_URL=https://streamlens-clickhouse-mcp-148137280149.us-central1.run.app/mcp

# gemini-3.8-flash is served only from the global endpoint, independent of
# the region Agent Runtime deploys into.
STREAMLENS_MODEL_LOCATION=global
